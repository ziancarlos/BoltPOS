<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <meta name="description" content="" />
    <meta name="author" content="" />

    <title>BoltPOS - Data Transaksi</title>

    <%- include("../templates/CustomLink") %>
    <link
      href="/vendor/datatables/dataTables.bootstrap4.min.css"
      rel="stylesheet"
    />
  </head>

  <body id="page-top">
    <div id="wrapper">
      <%- include("../templates/Sidebar") %>

      <div id="content-wrapper" class="d-flex flex-column">
        <div id="content">
          <%- include("../templates/Topbar") %>

          <div class="container-fluid">
            <div class="row">
              <div class="col-12">
                <div class="card shadow mb-4">
                  <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                      Data Transaksi
                    </h6>
                  </div>
                  <div class="card-body">
                    <div class="table-responsive">
                      <table
                        class="table table-bordered"
                        id="dataTable"
                        width="100%"
                        cellspacing="0"
                      >
                        <thead>
                          <tr>
                            <th>Id</th>
                            <th>Nama Pelanggan</th>
                            <th>Total</th>
                            <th>Metode Pembayaran</th>
                            <th>Status</th>
                            <th>Kasir</th>
                            <th>Tanggal</th>
                            <th>Aksi</th>
                          </tr>
                        </thead>
                        <tfoot>
                          <tr>
                            <th>Id</th>
                            <th>Nama Pelanggan</th>
                            <th>Total</th>
                            <th>Metode Pembayaran</th>
                            <th>Status</th>
                            <th>Kasir</th>
                            <th>Tanggal</th>
                            <th>Aksi</th>
                          </tr>
                        </tfoot>
                        <tbody>
                          <% transactions.forEach(function(trx) { %>
                          <tr>
                            <td><%= trx.transactionId %></td>
                            <td><%= trx.customerName %></td>
                            <td>Rp <%= trx.total.toLocaleString("id-ID") %></td>
                            <td><%= trx.paymentMethod || '-' %></td>
                            <td>
                              <% if (trx.status === 'SELESAI') { %>
                              <span class="badge badge-success"
                                ><%= trx.status %></span
                              >
                              <% } else if (trx.status === 'PROSES') { %>
                              <span class="badge badge-warning text-dark"
                                ><%= trx.status %></span
                              >
                              <% } else if (trx.status === 'DIBATALKAN') { %>
                              <span class="badge badge-danger"
                                ><%= trx.status %></span
                              >
                              <% } else { %>
                              <span class="badge badge-secondary"
                                ><%= trx.status %></span
                              >
                              <% } %>
                            </td>
                            <td><%= trx.user?.username || '-' %></td>
                            <td>
                              <%= trx.createdAt.toLocaleDateString("id-ID") %>
                            </td>
                            <td>
                              <a
                                class="btn btn-primary"
                                href="/transactions/<%= trx.transactionId %>/detail"
                              >
                                <i class="fas fa-eye"></i>
                              </a>
                              <a
                                class="btn btn-danger btn-delete-transaction"
                                href="#"
                                data-id="<%= trx.transactionId %>"
                              >
                                <i class="fas fa-trash"></i>
                              </a>
                            </td>
                          </tr>
                          <% }) %>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <%- include("../templates/Footer") %>
      </div>
    </div>

    <%- include("../templates/Script") %>
    <script src="/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="/vendor/datatables/dataTables.bootstrap4.min.js"></script>
    <script src="/js/demo/datatables-demo.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <% if (successMessage) { %>
    <script>
      Swal.fire({
        icon: "success",
        title: "Berhasil!",
        text: "<%= successMessage %>",
        confirmButtonColor: "#3085d6",
      });
    </script>
    <% } else if (errorMessage) { %>
    <script>
      Swal.fire({
        icon: "error",
        title: "Gagal!",
        html: "<%= errorMessage %>",
        confirmButtonColor: "#3085d6",
      });
    </script>
    <% } %>
  </body>
</html>
