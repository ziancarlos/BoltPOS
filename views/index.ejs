<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BoltPOS - Point of Sale untuk UMKM</title>
    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <style>
      .hero-section {
        background: linear-gradient(135deg, #6e8efb, #a777e3);
        color: white;
        padding: 5rem 0;
      }
      .feature-icon {
        font-size: 2.5rem;
        margin-bottom: 1rem;
        color: #6e8efb;
      }
      .cta-section {
        background-color: #f8f9fa;
        padding: 4rem 0;
      }
    </style>
  </head>
  <body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <a class="navbar-brand" href="#">
          <i class="fas fa-bolt me-2"></i>BoltPOS
        </a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <a class="nav-link" href="#features">Fitur</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="#about">Tentang</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero-section text-center">
      <div class="container">
        <h1 class="display-4 fw-bold mb-4">BoltPOS</h1>
        <p class="lead mb-5">
          Sistem Point of Sale modern untuk UMKM kecil yang ingin berkembang
        </p>
        <a href="#features" class="btn btn-light btn-lg px-4 me-2"
          >Pelajari Fitur</a
        >
        <a href="#contact" class="btn btn-outline-light btn-lg px-4"
          >Hubungi Kami</a
        >
      </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="py-5">
      <div class="container">
        <div class="text-center mb-5">
          <h2>Fitur Unggulan BoltPOS</h2>
          <p class="lead text-muted">
            Semua yang Anda butuhkan untuk mengelola bisnis kecil Anda
          </p>
        </div>

        <div class="row g-4">
          <div class="col-md-3 text-center">
            <div class="feature-icon">
              <i class="fas fa-list"></i>
            </div>
            <h4>Manajemen Kategori</h4>
            <p class="text-muted">
              Kelompokkan produk Anda dengan kategori untuk memudahkan pencarian
            </p>
          </div>

          <div class="col-md-3 text-center">
            <div class="feature-icon">
              <i class="fas fa-utensils"></i>
            </div>
            <h4>Manajemen Menu</h4>
            <p class="text-muted">Tambah, edit, dan hapus menu dengan mudah</p>
          </div>

          <div class="col-md-3 text-center">
            <div class="feature-icon">
              <i class="fas fa-cash-register"></i>
            </div>
            <h4>Sistem Transaksi</h4>
            <p class="text-muted">Proses pembayaran cepat dan efisien</p>
          </div>

          <div class="col-md-3 text-center">
            <div class="feature-icon">
              <i class="fas fa-chart-line"></i>
            </div>
            <h4>Dashboard & Laporan</h4>
            <p class="text-muted">
              Pantau penjualan dan pengeluaran dengan analisis lengkap
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section id="about" class="py-5 bg-light">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-md-6">
            <h2>Tentang BoltPOS</h2>
            <p class="lead">Solusi tepat untuk bisnis kecil Anda</p>
            <p>
              BoltPOS dikembangkan sebagai proyek akhir Phase 1 Bootcamp dengan
              tujuan membantu UMKM kecil dalam mengelola operasional harian
              mereka. Sistem ini dirancang sederhana namun powerful dengan
              antarmuka yang mudah digunakan.
            </p>
            <p>
              Dengan BoltPOS, Anda bisa fokus pada pengembangan bisnis sementara
              kami yang mengurusi sistem penjualan Anda.
            </p>
          </div>
          <div class="col-md-6">
            <img
              src="/img/show.png"
              alt="BoltPOS Interface"
              class="img-fluid rounded shadow"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section id="contact" class="cta-section text-center">
      <div class="container">
        <h2 class="mb-4">Tertarik Menggunakan BoltPOS?</h2>
        <p class="lead mb-5">Hubungi kami untuk informasi lebih lanjut</p>
        <div class="row justify-content-center">
          <div class="col-md-6">
            <form>
              <div class="mb-3">
                <input
                  type="text"
                  class="form-control"
                  placeholder="Nama Anda"
                />
              </div>
              <div class="mb-3">
                <input
                  type="email"
                  class="form-control"
                  placeholder="Email Anda"
                />
              </div>
              <div class="mb-3">
                <textarea
                  class="form-control"
                  rows="3"
                  placeholder="Pesan Anda"
                ></textarea>
              </div>
              <button type="submit" class="btn btn-primary btn-lg">
                Kirim Pesan
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="bg-dark text-white py-4">
      <div class="container text-center">
        <p class="mb-0">&copy; 2023 BoltPOS. All rights reserved.</p>
      </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
